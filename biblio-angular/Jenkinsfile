pipeline {
    agent {
        agent {
            docker {
                image 'node:20'
                args '--network devops'
            }
        }
    }

    stages {
        

        stage('Build') {
            steps {
                dir('biblio-angular') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Docker build') {
                    
                steps {
                    dir('biblio-angular') {
                        sh 'docker build -t biblio-angular .'
                    }
                }
                    
            }

        stage('SonarQube Analysis') {
            steps {
                dir('biblio-angular') {
                    withSonarQubeEnv('sonar') {
                        sh '''
                        sonar-scanner \
                        -Dsonar.projectKey=biblio-angular \
                        -Dsonar.sources=src \
                        -Dsonar.host.url=http://sonar:9000
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                waitForQualityGate abortPipeline: true
            }
        }
    }
}