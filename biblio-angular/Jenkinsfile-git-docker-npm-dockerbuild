pipeline {
    agent any

    stages {
        stage('NPM build') {
            agent {
                docker {
                    image 'node:lts-bullseye'
                    args '-v $HOME/.npm:/root/.npm:z -u root'
                    reuseNode true
                }
            }
            steps {
                dir('biblio-angular') {
                    sh 'npm install'
                    sh './node_modules/.bin/ng build'
                }
            }
        }

        stage('SonarQube') {
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:latest'
                    args '-u root'
                    reuseNode true
                }
            }
            steps {
                dir('biblio-angular') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            sonar-scanner \
                                -Dsonar.projectKey=biblio-angular \
                                -Dsonar.sources=src \
                                -Dsonar.exclusions=**/*.spec.ts,**/node_modules/**
                        '''
                    }
                }
            }
        }

        stage('Docker build') {
            steps {
                dir('biblio-angular') {
                    sh 'docker build -t ajc/biblio-angular .'
                }
            }
        }

        stage('Docker deploy') {
            steps {
                sh 'docker compose up -d --no-deps biblio-angular'
            }
        }
    }
}