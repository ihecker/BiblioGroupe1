pipeline {
    agent any

    stages {
        stage('Maven build') {
            agent {
                docker {
                    image 'maven:3.9.11-eclipse-temurin-21'
                    args '--network devops -v $HOME/.m2:/root/.m2:z -u root'
                    reuseNode true
                }
            }
            steps {
                dir('biblio') {
                    sh 'mvn package'
                }
            }
        }

        stage('SonarQube') {
            agent {
                docker {
                    image 'maven:3.9.11-eclipse-temurin-21'
                    args '--network devops -v $HOME/.m2:/root/.m2:z -u root'
                    reuseNode true
                }
            }
            steps {
                dir('biblio') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn verify sonar:sonar'
                    }
                }
            }
        }

        stage('Docker build') {
            steps {
                dir('biblio') {
                    sh 'docker build -t ajc/biblio .'
                }
            }
        }

        stage('Docker deploy') {
            steps {
                sh 'docker compose up -d --no-deps biblio-app'
            }
        }
    }
}